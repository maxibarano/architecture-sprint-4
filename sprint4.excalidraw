    {
      "id": "9mFu2Xc4OfKWuwRRGyXHe",
      "type": "text",
      "x": 2389.7989151386987,
      "y": 2914.426681153885,
      "width": 514.5596313476562,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e03131",
