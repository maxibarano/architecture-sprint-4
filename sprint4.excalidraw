    },
    {
      "id": "K5tgOraUG8PDn1Xd8-f8S",
      "type": "text",
      "x": 5962.6871079991015,
      "y": 1250.9393616962477,
      "width": 544.0397338867188,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "wKP6gXf-Pj_Zrq5mL8e-D"
      ],
      "frameId": "2fq8rPbXDYVjzAqDcGoSj",
      "index": "bEPV",
      "roundness": null,
      "seed": 1939972676,
      "version": 336,
      "versionNonce": 471147485,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1740246718909,
      "link": null,
      "locked": false,
      "text": "Потенциально будет сложно внедрить трейсинг в MES.\nТак как это купленная система и не очень большое\nпонимание как её дорабатывать. Как я понял это из тз.\nДоработка может оказаться долгой.\nВ остальных частях системы не вижу проблем для\nвнедрения.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "Es5YvBO5YEnjRtZ84w5qU",
      "originalText": "Потенциально будет сложно внедрить трейсинг в MES. Так как это купленная система и не очень большое понимание как её дорабатывать. Как я понял это из тз. Доработка может оказаться долгой.\nВ остальных частях системы не вижу проблем для внедрения.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_dze_m6p8p-cY57fmzq43",
      "type": "text",
      "x": 5876.975003054249,
      "y": 1418.0990890547137,
      "width": 191.26792907714844,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "uTsip9y7a-jW-Ni1xC3KJ"
      ],
      "frameId": "2fq8rPbXDYVjzAqDcGoSj",
      "index": "bER",
      "roundness": null,
      "seed": 473523324,
      "version": 1858,
      "versionNonce": 685678653,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1740246718909,
      "link": null,
      "locked": false,
      "text": "Безопасность.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Безопасность.",
      "autoResize": true,
      "lineHeight": 1.25
    },
