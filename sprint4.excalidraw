    {
      "id": "vfxzxUHYDn1rtnT0ta14m",
      "type": "text",
      "x": 2389.9290422292092,
      "y": 114.66057617521426,
      "width": 555.73974609375,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
