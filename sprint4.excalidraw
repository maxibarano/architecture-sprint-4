      "x": 5951.70697470672,
      "y": 337.5665768243176,
      "width": 566.0000002161659,
      "height": 460.0000001756825,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
