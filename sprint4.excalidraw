    {
      "id": "oeBS0sVXinl0BIevmDwT_",
      "type": "text",
      "x": 5977.147160341846,
      "y": 1474.4393617213802,
      "width": 515.11962890625,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
