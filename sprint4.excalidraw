      "link": null,
      "locked": false
    },
    {
      "id": "ejzNYbgP6D25ymqH3A10u",
      "type": "text",
      "x": 9625.036093388535,
      "y": 136.7559309070275,
      "width": 555.7996826171875,
      "height": 750,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "HchPtYC3lb05_upG6esDw"
      ],
      "frameId": "b66Jyq2Wj0OzzRWu_3WPT",
      "index": "bIu",
      "roundness": null,
      "seed": 1272901244,
      "version": 999,
      "versionNonce": 1250385267,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1740254326698,
      "link": null,
      "locked": false,
      "text": "1.  Shop API [INFO]\n    1.1 Идентификатор заказчика\n    1.2 Идентификатор заказа\n    1.3 Статус заказа\n    1.4 Временная метка\n2. CRM API [INFO]\n    1.1 Идентификатор менеджера\n    1.2 Идентификатор заказа\n    1.3 Статус заказа\n    1.4 Временная метка\n3. MES API [INFO]\n    1.1 Идентификатор оператора\n    1.2 Идентификатор заказа\n    1.3 Статус заказа\n    1.4 Временная метка\n\nShop API, CRM API, MES API [ERROR]\nОшибки при взаимодействии с другими сервисами\n1. Статус код\n2. Сервис\n3. Текст ошибки\n4. Временная метка\n\nShop API, CRM API, MES API [FATAL]\nОшибки при взаимодействии с объектами инфраструктуры\nБД, брокер, с3\n1. Объект инфраструктуры\n2. Ошибка\n3. Входные данные если были\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "1oYEvSb31YxO6ERzAKWBR",
      "originalText": "1.  Shop API [INFO]\n    1.1 Идентификатор заказчика\n    1.2 Идентификатор заказа\n    1.3 Статус заказа\n    1.4 Временная метка\n2. CRM API [INFO]\n    1.1 Идентификатор менеджера\n    1.2 Идентификатор заказа\n    1.3 Статус заказа\n    1.4 Временная метка\n3. MES API [INFO]\n    1.1 Идентификатор оператора\n    1.2 Идентификатор заказа\n    1.3 Статус заказа\n    1.4 Временная метка\n\nShop API, CRM API, MES API [ERROR]\nОшибки при взаимодействии с другими сервисами\n1. Статус код\n2. Сервис\n3. Текст ошибки\n4. Временная метка\n\nShop API, CRM API, MES API [FATAL]\nОшибки при взаимодействии с объектами инфраструктуры\nБД, брокер, с3\n1. Объект инфраструктуры\n2. Ошибка\n3. Входные данные если были\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wl8pXwLpbtlWJcudVss9Z",
