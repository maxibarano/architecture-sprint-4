    },
    {
      "id": "CJGXgxyIK_ozpfgu9x9dA",
      "type": "rectangle",
      "x": 5951.70697507769,
      "y": 843.1605283928478,
      "width": 566,
      "height": 335,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "IhLIoBGa--U-OhOx8nicN"
      ],
      "frameId": "2fq8rPbXDYVjzAqDcGoSj",
      "index": "bBz",
      "roundness": {
        "type": 3
      },
      "seed": 1497487172,
      "version": 926,
      "versionNonce": 264612509,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "tYIPmI44Hc_LMffA3GQew",
          "type": "text"
        }
      ],
      "updated": 1740247243630,
      "link": null,
      "locked": false
    },
    {
      "id": "tYIPmI44Hc_LMffA3GQew",
      "type": "text",
      "x": 5956.70697507769,
      "y": 848.1605283928478,
      "width": 547.5796508789062,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "IhLIoBGa--U-OhOx8nicN"
      ],
      "frameId": "2fq8rPbXDYVjzAqDcGoSj",
      "index": "bC0",
      "roundness": null,
      "seed": 84823748,
      "version": 2506,
      "versionNonce": 1246777085,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1740247243630,
      "link": null,
      "locked": false,
      "text": "Нужно развернуть систему сбора трейсинга, которая \n    будет собирать данные и давать возможность их\nвизуализировать. Внедрим open-source решение jaeger.\n1. Развернуть jaeger collector\n2. В сервисах подключить биоблиотеки opentelemetry\n3. Рядом с сервисами развернуть jaeger agent, который\n   будет посылать данные в коллектор\n4. Развернуть хранилище, где будут храниться данные о\n   трассировке, можно использовать\nprometheus(добавленный для мониторинга), который\nбудет забирать данные из коллектора.\n\nСсылка на drawio",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "CJGXgxyIK_ozpfgu9x9dA",
      "originalText": "Нужно развернуть систему сбора трейсинга, которая \n    будет собирать данные и давать возможность их визуализировать. Внедрим open-source решение jaeger.\n1. Развернуть jaeger collector\n2. В сервисах подключить биоблиотеки opentelemetry\n3. Рядом с сервисами развернуть jaeger agent, который\n   будет посылать данные в коллектор\n4. Развернуть хранилище, где будут храниться данные о\n   трассировке, можно использовать prometheus(добавленный для мониторинга), который будет забирать данные из коллектора.\n\nСсылка на drawio",
      "autoResize": true,
      "lineHeight": 1.25
    },
