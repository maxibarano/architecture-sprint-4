        }
      ],
      "updated": 1740303566865,
      "link": null,
      "locked": false
    },
    {
      "id": "zf-wlWV6eEG2UUmpI1FyW",
      "type": "text",
      "x": 15520.88954746764,
      "y": 1835.6030396556316,
      "width": 450.60760498046875,
      "height": 260,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e03131",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "v7kxLJMzJXUWoQb_MHSOa",
      "index": "bPZ",
      "roundness": null,
      "seed": 1382409884,
      "version": 1888,
      "versionNonce": 2060498988,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1740303566865,
      "link": null,
      "locked": false,
      "text": "Серверное кэширование\nТип: Refresh-ahead\nВыставляем кэш на заказы 5 минут.\nПринудительное обновление каждую минуту не закрытых\nзаказов.\nИнвалидация: При изменении статуса заказов, при\nпоступлении новых.\nПозволит увеличить скорость отдачи страницы заказов.\nОбновление данных в фоне позволит избежать кэш-мисов,\nкоторые бы допускали поход к бд и вызывали долгие\nответы системы. Влияние - операторы смогут быстрее\nбрать заказы, что должно снизить общее время\nвыполнения заказа.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "l72c5_js4V2THeVAuZ39o",
      "originalText": "Серверное кэширование\nТип: Refresh-ahead\nВыставляем кэш на заказы 5 минут.\nПринудительное обновление каждую минуту не закрытых заказов.\nИнвалидация: При изменении статуса заказов, при поступлении новых.\nПозволит увеличить скорость отдачи страницы заказов. Обновление данных в фоне позволит избежать кэш-мисов, которые бы допускали поход к бд и вызывали долгие ответы системы. Влияние - операторы смогут быстрее брать заказы, что должно снизить общее время выполнения заказа.",
      "autoResize": true,
      "lineHeight": 1.25
    },
